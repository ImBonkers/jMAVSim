{
  "board": "demo",
  "description": "Demo showcase \u2014 three flight profiles with the NPU at full load, including in-flight NPU telemetry verification",
  "connection": {
    "type": "serial",
    "port": "/dev/ttyACM1",
    "baudRate": 921600
  },
  "pauseBetweenRunsSeconds": 2,
  "variables": {
    "NPU_LOAD": 100
  },
  "scenarios": [
    {
      "file": "scenarios/S09_takeoff_land_single.json",
      "repetitions": 1
    },
    {
      "file": "scenarios/S23_hitl_loop_validation.json",
      "repetitions": 1
    },
    {
      "file": "scenarios/S24_npu_data_exchange.json",
      "repetitions": 1
    }
  ]
}
