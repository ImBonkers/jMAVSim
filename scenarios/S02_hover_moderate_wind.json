{
  "name": "S02_hover_moderate_wind",
  "description": "Position hold at 10m under 6 m/s steady wind. Elevated controller effort as baseline for wind interaction.",
  "globalTimeoutSeconds": 120,
  "steps": [
    {
      "type": "reboot",
      "timeoutSeconds": 45
    },
    {
      "type": "setNpuLoad",
      "percent": "$NPU_LOAD",
      "timeoutSeconds": 5
    },
    {
      "type": "wait",
      "durationSeconds": 5
    },
    {
      "type": "arm",
      "timeoutSeconds": 30
    },
    {
      "type": "takeoff",
      "altitude": 10.0,
      "tolerance": 0.5,
      "settleSeconds": 3.0,
      "timeoutSeconds": 30
    },
    {
      "type": "setWind",
      "x": 6,
      "y": 0,
      "z": 0
    },
    {
      "type": "wait",
      "durationSeconds": 3
    },
    {
      "type": "hover",
      "durationSeconds": 30,
      "maxDrift": 0.8,
      "timeoutSeconds": 45
    },
    {
      "type": "setWind",
      "x": 0,
      "y": 0,
      "z": 0
    },
    {
      "type": "land",
      "settleSeconds": 2.0,
      "timeoutSeconds": 30
    },
    {
      "type": "disarm",
      "timeoutSeconds": 10
    }
  ]
}
