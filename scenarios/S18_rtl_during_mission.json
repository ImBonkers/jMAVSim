{
  "name": "S18_rtl_during_mission",
  "description": "RTL triggered mid-waypoint. Tests emergency return path computation and execution under NPU load.",
  "globalTimeoutSeconds": 240,
  "steps": [
    {
      "type": "reboot",
      "timeoutSeconds": 45
    },
    {
      "type": "setNpuLoad",
      "percent": "$NPU_LOAD",
      "timeoutSeconds": 5
    },
    {
      "type": "wait",
      "durationSeconds": 5
    },
    {
      "type": "arm",
      "timeoutSeconds": 30
    },
    {
      "type": "takeoff",
      "altitude": 15.0,
      "tolerance": 0.5,
      "settleSeconds": 2.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": 30,
      "y": 0,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": 50,
      "y": 20,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 30
    },
    {
      "type": "setMode",
      "mode": "RTL",
      "timeoutSeconds": 10
    },
    {
      "type": "waitForDisarm",
      "timeoutSeconds": 90
    },
    {
      "type": "disarm",
      "timeoutSeconds": 10,
      "force": true
    }
  ]
}
