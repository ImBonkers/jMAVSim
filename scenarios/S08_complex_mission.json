{
  "name": "S08_complex_mission",
  "description": "Multi-segment mission: varying altitudes (10-25m), speeds, loiter point (30s), curved transitions.",
  "globalTimeoutSeconds": 360,
  "steps": [
    {
      "type": "reboot",
      "timeoutSeconds": 45
    },
    {
      "type": "setNpuLoad",
      "percent": "$NPU_LOAD",
      "timeoutSeconds": 5
    },
    {
      "type": "wait",
      "durationSeconds": 5
    },
    {
      "type": "arm",
      "timeoutSeconds": 30
    },
    {
      "type": "takeoff",
      "altitude": 10.0,
      "tolerance": 0.5,
      "settleSeconds": 2.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": 20,
      "y": 0,
      "z": -10,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": 30,
      "y": 10,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": 30,
      "y": 30,
      "z": -20,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": 20,
      "y": 40,
      "z": -25,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 30
    },
    {
      "type": "hover",
      "durationSeconds": 30,
      "maxDrift": 0.5,
      "timeoutSeconds": 40,
      "critical": false
    },
    {
      "type": "goto",
      "x": 10,
      "y": 40,
      "z": -20,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": 0,
      "y": 30,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": -10,
      "y": 15,
      "z": -10,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": 0,
      "y": 0,
      "z": -10,
      "tolerance": 1.0,
      "settleSeconds": 2.0,
      "timeoutSeconds": 30
    },
    {
      "type": "land",
      "settleSeconds": 2.0,
      "timeoutSeconds": 30
    },
    {
      "type": "disarm",
      "timeoutSeconds": 10
    }
  ]
}
