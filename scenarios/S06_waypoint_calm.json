{
  "name": "S06_waypoint_calm",
  "description": "4-waypoint square pattern at 15m altitude, no wind. Core autonomous navigation test.",
  "globalTimeoutSeconds": 300,
  "steps": [
    {
      "type": "reboot",
      "timeoutSeconds": 45
    },
    {
      "type": "setNpuLoad",
      "percent": "$NPU_LOAD",
      "timeoutSeconds": 5
    },
    {
      "type": "wait",
      "durationSeconds": 5
    },
    {
      "type": "arm",
      "timeoutSeconds": 30
    },
    {
      "type": "takeoff",
      "altitude": 15.0,
      "tolerance": 0.5,
      "settleSeconds": 3.0,
      "timeoutSeconds": 30
    },
    {
      "type": "hover",
      "durationSeconds": 3,
      "maxDrift": 0.3,
      "timeoutSeconds": 10,
      "critical": false
    },
    {
      "type": "goto",
      "x": 30,
      "y": 0,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 2.0,
      "timeoutSeconds": 45
    },
    {
      "type": "goto",
      "x": 30,
      "y": 30,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 2.0,
      "timeoutSeconds": 45
    },
    {
      "type": "goto",
      "x": 0,
      "y": 30,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 2.0,
      "timeoutSeconds": 45
    },
    {
      "type": "goto",
      "x": 0,
      "y": 0,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 2.0,
      "timeoutSeconds": 45
    },
    {
      "type": "hover",
      "durationSeconds": 3,
      "maxDrift": 0.5,
      "timeoutSeconds": 10,
      "critical": false
    },
    {
      "type": "land",
      "settleSeconds": 2.0,
      "timeoutSeconds": 30
    },
    {
      "type": "disarm",
      "timeoutSeconds": 10
    }
  ]
}
