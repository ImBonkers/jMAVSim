{
  "name": "S15_mission_gps_dropout",
  "description": "Waypoint mission with 5-second GPS blackout mid-leg. Tests dead reckoning performance under NPU load.",
  "globalTimeoutSeconds": 300,
  "steps": [
    {
      "type": "reboot",
      "timeoutSeconds": 45
    },
    {
      "type": "setNpuLoad",
      "percent": "$NPU_LOAD",
      "timeoutSeconds": 5
    },
    {
      "type": "wait",
      "durationSeconds": 5
    },
    {
      "type": "arm",
      "timeoutSeconds": 30
    },
    {
      "type": "takeoff",
      "altitude": 15.0,
      "tolerance": 0.5,
      "settleSeconds": 2.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": 20,
      "y": 0,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 30
    },
    {
      "type": "disableGps",
      "durationSeconds": 5
    },
    {
      "type": "goto",
      "x": 40,
      "y": 0,
      "z": -15,
      "tolerance": 2.0,
      "settleSeconds": 2.0,
      "timeoutSeconds": 45
    },
    {
      "type": "goto",
      "x": 0,
      "y": 0,
      "z": -15,
      "tolerance": 1.5,
      "settleSeconds": 2.0,
      "timeoutSeconds": 45
    },
    {
      "type": "land",
      "settleSeconds": 2.0,
      "timeoutSeconds": 30
    },
    {
      "type": "disarm",
      "timeoutSeconds": 10
    }
  ]
}
