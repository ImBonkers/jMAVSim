{
  "name": "wind_disturbance_test",
  "description": "Validate flight stability under various wind conditions including fluctuating gusts",
  "globalTimeoutSeconds": 300,
  "steps": [
    { "type": "arm", "timeoutSeconds": 15 },
    { "type": "takeoff", "altitude": 8.0, "tolerance": 0.5, "settleSeconds": 2.0, "timeoutSeconds": 30 },

    { "type": "hover", "durationSeconds": 5, "maxDrift": 0.3, "timeoutSeconds": 15, "critical": false },

    { "type": "setWind", "x": 5, "y": 0, "z": 0 },
    { "type": "wait", "durationSeconds": 2 },
    { "type": "hover", "durationSeconds": 5, "maxDrift": 0.8, "timeoutSeconds": 15, "critical": false },

    { "type": "setWind", "x": 0, "y": 5, "z": 0 },
    { "type": "wait", "durationSeconds": 2 },
    { "type": "hover", "durationSeconds": 5, "maxDrift": 0.8, "timeoutSeconds": 15, "critical": false },

    { "type": "setWind", "x": 1, "y": 0, "z": 0, "minStrength": 2, "maxStrength": 7 },
    { "type": "wait", "durationSeconds": 2 },
    { "type": "hover", "durationSeconds": 8, "maxDrift": 1.2, "timeoutSeconds": 20, "critical": false },

    { "type": "setWind", "x": 1, "y": 1, "z": 0, "minStrength": 3, "maxStrength": 10 },
    { "type": "wait", "durationSeconds": 2 },
    { "type": "hover", "durationSeconds": 8, "maxDrift": 1.5, "timeoutSeconds": 20, "critical": false },

    { "type": "setWind", "x": 0, "y": 0, "z": 0 },
    { "type": "wait", "durationSeconds": 2 },
    { "type": "hover", "durationSeconds": 3, "maxDrift": 0.3, "timeoutSeconds": 10, "critical": false },

    { "type": "land", "settleSeconds": 2.0, "timeoutSeconds": 30 },
    { "type": "disarm", "timeoutSeconds": 10 }
  ]
}
