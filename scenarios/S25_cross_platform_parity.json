{
  "name": "S25_cross_platform_parity",
  "description": "Identical mission on Pixhawk and STM32N6 (0% NPU). Compare flight behavior to isolate platform differences.",
  "globalTimeoutSeconds": 300,
  "steps": [
    {
      "type": "reboot",
      "timeoutSeconds": 45
    },
    {
      "type": "setNpuLoad",
      "percent": "$NPU_LOAD",
      "timeoutSeconds": 5
    },
    {
      "type": "wait",
      "durationSeconds": 5
    },
    {
      "type": "arm",
      "timeoutSeconds": 30
    },
    {
      "type": "takeoff",
      "altitude": 15.0,
      "tolerance": 0.5,
      "settleSeconds": 3.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": 30,
      "y": 0,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 2.0,
      "timeoutSeconds": 45
    },
    {
      "type": "goto",
      "x": 30,
      "y": 30,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 2.0,
      "timeoutSeconds": 45
    },
    {
      "type": "goto",
      "x": 0,
      "y": 30,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 2.0,
      "timeoutSeconds": 45
    },
    {
      "type": "goto",
      "x": 0,
      "y": 0,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 2.0,
      "timeoutSeconds": 45
    },
    {
      "type": "hover",
      "durationSeconds": 5,
      "maxDrift": 0.5,
      "timeoutSeconds": 15,
      "critical": false
    },
    {
      "type": "land",
      "settleSeconds": 2.0,
      "timeoutSeconds": 30
    },
    {
      "type": "disarm",
      "timeoutSeconds": 10
    }
  ]
}
