{
  "name": "S13_fast_altitude_changes",
  "description": "Repeated +/-5m altitude step commands. Tests vertical controller under load.",
  "globalTimeoutSeconds": 240,
  "steps": [
    {
      "type": "reboot",
      "timeoutSeconds": 45
    },
    {
      "type": "setNpuLoad",
      "percent": "$NPU_LOAD",
      "timeoutSeconds": 5
    },
    {
      "type": "wait",
      "durationSeconds": 5
    },
    {
      "type": "arm",
      "timeoutSeconds": 30
    },
    {
      "type": "takeoff",
      "altitude": 10.0,
      "tolerance": 0.5,
      "settleSeconds": 2.0,
      "timeoutSeconds": 30
    },
    {
      "type": "goto",
      "x": 0,
      "y": 0,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 20
    },
    {
      "type": "goto",
      "x": 0,
      "y": 0,
      "z": -10,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 20
    },
    {
      "type": "goto",
      "x": 0,
      "y": 0,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 20
    },
    {
      "type": "goto",
      "x": 0,
      "y": 0,
      "z": -10,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 20
    },
    {
      "type": "goto",
      "x": 0,
      "y": 0,
      "z": -15,
      "tolerance": 1.0,
      "settleSeconds": 1.0,
      "timeoutSeconds": 20
    },
    {
      "type": "goto",
      "x": 0,
      "y": 0,
      "z": -10,
      "tolerance": 1.0,
      "settleSeconds": 2.0,
      "timeoutSeconds": 20
    },
    {
      "type": "land",
      "settleSeconds": 2.0,
      "timeoutSeconds": 30
    },
    {
      "type": "disarm",
      "timeoutSeconds": 10
    }
  ]
}
